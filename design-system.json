{
  "meta": {
    "id": "growth-journal",
    "name": "成长手账 · parent-guide 成长视图",
    "createdAt": "2026-10-06",
    "axis": {
      "colorMood": "warm",
      "typeMood": "modern",
      "density": "standard",
